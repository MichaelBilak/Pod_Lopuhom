---
interface Props {
  title: string;
  description: string;
  materials: string;
  price: string;
  images: string[];
  whatsappNumber: string;
}

const { title, description, materials, price, images, whatsappNumber } = Astro.props;
const message = encodeURIComponent(`Hi! I want to order: ${title} (${price}).`);
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${message}`;
const imageFocus: Record<string, string> = {
  "/images/products/product_7.0.JPG": "35% 55%",
};
const getObjectPosition = (src: string) => imageFocus[src] ?? "50% 50%";
---

<section class="mx-auto w-full max-w-5xl px-4 pb-24 pt-8 sm:px-6 lg:pb-16">
  <!-- Unified gallery block with thumbnails + main image -->
  <div class="grid gap-6 lg:grid-cols-[1.1fr,0.9fr]">
    <div class="rounded-3xl border border-slate-200 bg-white/90 p-3 sm:p-4">
      <div class="grid gap-4 md:grid-cols-[80px,1fr]">
        <div class="order-2 flex gap-3 overflow-x-auto md:order-1 md:flex-col md:overflow-visible">
          {images.slice(0, 4).map((image, index) => (
            <button
              type="button"
              class:list={[
                "group h-16 w-16 flex-shrink-0 overflow-hidden rounded-2xl border bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 sm:h-20 sm:w-20",
                index === 0
                  ? "border-slate-900 ring-2 ring-slate-900 ring-offset-2"
                  : "border-slate-200",
              ]}
              data-thumb
              aria-label={`View image ${index + 1}`}
              aria-current={index === 0 ? "true" : "false"}
            >
              <img
                src={image}
                alt={`${title} thumbnail ${index + 1}`}
                class="h-full w-full object-cover transition duration-200 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </button>
          ))}
        </div>
        <div class="order-1 aspect-[4/5] w-full overflow-hidden rounded-3xl bg-slate-100">
          <img
            src={images[0]}
            alt={title}
            class="h-full w-full object-cover object-center"
            style={`object-position: ${getObjectPosition(images[0])};`}
            data-main-image
          />
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-slate-200/70 bg-white/80 divide-y divide-slate-200/70">
      <div class="p-4 space-y-3">
        <h1 class="text-2xl font-semibold text-slate-900 sm:text-3xl">
          {title}
        </h1>
        <p class="text-sm text-slate-600 sm:text-base">{description}</p>
        <p class="inline-flex rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700">
          Materials: {materials}
        </p>
      </div>

      <div class="p-4">
        <div class="flex items-center justify-between">
          <span class="text-[10px] uppercase tracking-[0.2em] text-slate-500">
            Price
          </span>
          <span class="text-2xl font-semibold text-slate-900">{price}</span>
        </div>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noreferrer"
          class="mt-4 hidden w-full items-center justify-center rounded-full border border-slate-900 px-6 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-slate-900 transition hover:bg-slate-900 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 sm:inline-flex sm:text-sm"
        >
          Choose and message
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile sticky purchase bar keeps CTA visible while scrolling -->
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200/80 bg-white/95 px-4 py-3 backdrop-blur sm:hidden">
    <div class="mx-auto flex w-full max-w-5xl items-center justify-between gap-3">
      <div>
        <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500">
          Price
        </p>
        <p class="text-lg font-semibold text-slate-900">{price}</p>
      </div>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center rounded-full border border-slate-900 px-5 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-900 transition hover:bg-slate-900 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
      >
        Choose
      </a>
    </div>
  </div>
</section>
