---
interface Props {
  slug: string;
  title: string;
  materials: string;
  price: string;
  description: string;
  image: string;
}

const { slug, title, materials, price, description, image } = Astro.props;
---
<article class="motion-card rounded-3xl border border-border bg-white shadow-soft">
  <button
    type="button"
    class="flex h-[320px] w-full flex-col rounded-3xl p-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 sm:h-[360px] sm:p-5 lg:h-[380px] lg:p-6"
    aria-label={`View details for ${title}`}
    data-product-card
    data-title={title}
    data-price={price}
    data-materials={materials}
    data-description={description}
    data-image={image}
  >
    <div class="motion-card__media product-frame mb-4 h-40 w-full rounded-2xl bg-panel sm:mb-5 sm:h-44 lg:h-48">
      <img
        src={image}
        alt={title}
        class="h-full w-full rounded-2xl object-cover object-center"
        loading="lazy"
      />
    </div>
    <div class="flex-1 space-y-2 sm:space-y-3">
      <div class="flex items-center justify-between gap-4">
        <h3 class="text-lg font-semibold">{title}</h3>
        <span class="text-xs font-semibold text-muted sm:text-sm">{price}</span>
      </div>
      <p class="card-materials text-xs text-muted sm:text-sm">{materials}</p>
      <p class="card-description text-xs text-muted sm:text-sm">{description}</p>
    </div>
    <div class="mt-auto pt-4">
      <span class="view-details">VIEW DETAILS</span>
    </div>
  </button>
</article>
