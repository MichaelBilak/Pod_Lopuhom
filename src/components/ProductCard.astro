---
interface Props {
  slug: string;
  title: string;
  materials: string;
  price: string;
  description: string;
  images: string[];
  enableModal?: boolean;
}

const { slug, title, materials, price, description, images, enableModal = false } =
  Astro.props;
const imageFocus: Record<string, string> = {
  "/images/products/product_7.0.JPG": "35% 55%",
};
const imageFit: Record<string, string> = {
  "/images/products/product_13.0.JPG": "contain",
};
const getObjectPosition = (src: string) => imageFocus[src] ?? "50% 50%";
const getObjectFit = (src: string) => imageFit[src] ?? "cover";
---
<article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-[0_12px_30px_rgba(15,23,42,0.06)] transition hover:-translate-y-1 hover:border-slate-300 hover:shadow-[0_18px_40px_rgba(15,23,42,0.12)]">
  {enableModal ? (
    <button
      type="button"
      class="flex h-full w-full flex-col gap-3 rounded-3xl p-3 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
      aria-label={`Open ${title} details`}
      data-product
      data-title={title}
      data-description={description}
      data-price={price}
      data-images={JSON.stringify(images)}
    >
      <div class="relative h-56 w-full overflow-hidden rounded-2xl bg-slate-100 sm:h-64 lg:h-72">
        <img
          src={images[0]}
          alt={title}
          class="h-full w-full origin-center rounded-2xl object-cover object-center transition duration-300 group-hover:scale-[1.06]"
          style={`object-position: ${getObjectPosition(images[0])}; object-fit: ${getObjectFit(
            images[0]
          )};`}
          loading="lazy"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent opacity-0 transition duration-300 group-hover:opacity-100"></div>
      </div>
      <div class="flex flex-1 flex-col gap-2 px-1 pb-1">
        <p class="text-xs font-medium tracking-[0.02em] text-slate-900 sm:text-sm">
          {title}
        </p>
        <p class="text-xs text-slate-600 sm:block">{materials}</p>
        <div class="mt-auto flex items-center justify-between gap-3">
          <span class="text-base font-semibold text-slate-900 sm:text-lg">
            {price}
          </span>
          <span class="text-[10px] uppercase tracking-[0.18em] text-slate-500">
            View details
          </span>
        </div>
      </div>
    </button>
  ) : (
    <a
      href={`/product/${slug}`}
      class="flex h-full w-full flex-col gap-3 rounded-3xl p-3 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
      aria-label={`Open ${title} details`}
    >
      <div class="relative h-56 w-full overflow-hidden rounded-2xl bg-slate-100 sm:h-64 lg:h-72">
        <img
          src={images[0]}
          alt={title}
          class="h-full w-full origin-center rounded-2xl object-cover object-center transition duration-300 group-hover:scale-[1.06]"
          style={`object-position: ${getObjectPosition(images[0])}; object-fit: ${getObjectFit(
            images[0]
          )};`}
          loading="lazy"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-transparent opacity-0 transition duration-300 group-hover:opacity-100"></div>
      </div>
      <div class="flex flex-1 flex-col gap-2 px-1 pb-1">
        <p class="text-xs font-medium tracking-[0.02em] text-slate-900 sm:text-sm">
          {title}
        </p>
        <p class="text-xs text-slate-600 sm:block">{materials}</p>
        <div class="mt-auto flex items-center justify-between gap-3">
          <span class="text-base font-semibold text-slate-900 sm:text-lg">
            {price}
          </span>
          <span class="text-[10px] uppercase tracking-[0.18em] text-slate-500">
            View details
          </span>
        </div>
      </div>
    </a>
  )}
</article>
