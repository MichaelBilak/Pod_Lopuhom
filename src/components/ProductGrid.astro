---
import ProductCard from "./ProductCard.astro";

interface Product {
  slug: string;
  title: string;
  description: string;
  materials: string;
  price: string;
  images: string[];
}

interface Props {
  products: Product[];
  enableModal?: boolean;
}

const { products, enableModal = false } = Astro.props;
---

<div class="grid grid-cols-2 gap-4 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
  {products.map((product) => (
    <ProductCard
      slug={product.slug}
      title={product.title}
      description={product.description}
      materials={product.materials}
      price={product.price}
      images={product.images}
      enableModal={enableModal}
    />
  ))}
</div>
