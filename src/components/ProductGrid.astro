---
interface Product {
  slug: string;
  title: string;
  description: string;
  price: string;
  images: string[];
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
  {products.map((product) => (
    <a
      href={`/product/${product.slug}`}
      class="group flex flex-col gap-4 rounded-3xl border border-white/70 bg-white/70 p-3 shadow-[0_12px_30px_rgba(15,23,42,0.08)] backdrop-blur-md transition hover:-translate-y-1 hover:border-white/90 hover:shadow-[0_18px_40px_rgba(15,23,42,0.14)]"
    >
      <div class="aspect-[4/5] w-full rounded-2xl bg-slate-100">
        <img
          src={product.images[0]}
          alt={product.title}
          class="h-full w-full rounded-2xl object-cover transition duration-300 group-hover:scale-[1.02]"
          loading="lazy"
        />
      </div>
      <div class="space-y-3 px-1 pb-1 text-left">
        <p class="text-sm font-medium text-slate-900">{product.title}</p>
        <p class="text-xs text-slate-600">
          {product.description.length > 80
            ? `${product.description.slice(0, 80)}...`
            : product.description}
        </p>
        <div class="flex items-center justify-between text-xs uppercase tracking-[0.2em] text-slate-500">
          <span>{product.price}</span>
          <span class="text-slate-700 transition group-hover:text-slate-900">
            View details
          </span>
        </div>
      </div>
    </a>
  ))}
</div>
