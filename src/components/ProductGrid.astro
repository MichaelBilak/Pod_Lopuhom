---
interface Product {
  slug: string;
  title: string;
  description: string;
  price: string;
  images: string[];
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="grid grid-cols-2 gap-6 lg:grid-cols-3">
  {products.map((product) => (
    <a
      href={`/product/${product.slug}`}
      class="group flex flex-col gap-3"
    >
      <div class="aspect-[4/5] w-full overflow-hidden rounded-3xl bg-slate-100">
        <img
          src={product.images[0]}
          alt={product.title}
          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
          loading="lazy"
        />
      </div>
      <div class="space-y-2 text-left">
        <p class="text-sm font-medium text-slate-900">{product.title}</p>
        <p class="text-xs text-slate-600">{product.description}</p>
        <div class="flex items-center justify-between text-xs uppercase tracking-[0.2em] text-slate-500">
          <span>{product.price}</span>
          <span class="text-slate-700 transition group-hover:text-slate-900">
            View details
          </span>
        </div>
      </div>
    </a>
  ))}
</div>
