---
interface Product {
  slug: string;
  title: string;
  description: string;
  price: string;
  images: string[];
}

interface Props {
  products: Product[];
  enableModal?: boolean;
}

const { products, enableModal = false } = Astro.props;
---

<div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
  {products.map((product) => (
    <div class="group flex flex-col gap-4 rounded-3xl border border-slate-200 bg-white p-3 shadow-[0_12px_30px_rgba(15,23,42,0.06)] transition hover:-translate-y-1 hover:border-slate-300 hover:shadow-[0_18px_40px_rgba(15,23,42,0.12)]">
      {enableModal ? (
        <button
          type="button"
          class="flex flex-col gap-4 text-left"
          data-product
          data-title={product.title}
          data-description={product.description}
          data-price={product.price}
          data-images={JSON.stringify(product.images)}
          aria-label={`Open ${product.title} details`}
        >
          <div class="aspect-[4/5] w-full rounded-2xl bg-slate-100">
            <img
              src={product.images[0]}
              alt={product.title}
              class="h-full w-full rounded-2xl object-cover transition duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
          </div>
          <div class="space-y-3 px-1 pb-1">
            <p class="text-sm font-medium text-slate-900">{product.title}</p>
            <p class="text-xs text-slate-600">
              {product.description.length > 80
                ? `${product.description.slice(0, 80)}...`
                : product.description}
            </p>
            <div class="flex items-center justify-between text-xs uppercase tracking-[0.2em] text-slate-500">
              <span>{product.price}</span>
              <span class="text-slate-700 transition group-hover:text-slate-900">
                View details
              </span>
            </div>
          </div>
        </button>
      ) : (
        <a href={`/product/${product.slug}`} class="flex flex-col gap-4 text-left">
          <div class="aspect-[4/5] w-full rounded-2xl bg-slate-100">
            <img
              src={product.images[0]}
              alt={product.title}
              class="h-full w-full rounded-2xl object-cover transition duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
          </div>
          <div class="space-y-3 px-1 pb-1">
            <p class="text-sm font-medium text-slate-900">{product.title}</p>
            <p class="text-xs text-slate-600">
              {product.description.length > 80
                ? `${product.description.slice(0, 80)}...`
                : product.description}
            </p>
            <div class="flex items-center justify-between text-xs uppercase tracking-[0.2em] text-slate-500">
              <span>{product.price}</span>
              <span class="text-slate-700 transition group-hover:text-slate-900">
                View details
              </span>
            </div>
          </div>
        </a>
      )}
    </div>
  ))}
</div>
