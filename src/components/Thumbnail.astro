---
interface Props {
  src: string;
  alt: string;
  ariaLabel: string;
  isActive?: boolean;
  dataThumb?: boolean;
}

const {
  src,
  alt,
  ariaLabel,
  isActive = false,
  dataThumb = false,
} = Astro.props;
---
<!-- Shared thumbnail: square, clipped, no padding, ring inset -->
<button
  type="button"
  class:list={[
    "group aspect-square h-16 w-16 overflow-hidden rounded-2xl border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 sm:h-20 sm:w-20",
    isActive
      ? "border-slate-900 ring-2 ring-inset ring-slate-900"
      : "border-slate-200",
  ]}
  data-thumb={dataThumb ? "" : undefined}
  aria-label={ariaLabel}
  aria-current={isActive ? "true" : "false"}
>
  <img
    src={src}
    alt={alt}
    class="h-full w-full object-contain object-center transition duration-200 group-hover:scale-[1.03]"
    loading="lazy"
  />
</button>
