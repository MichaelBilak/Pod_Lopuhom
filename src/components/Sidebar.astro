---
const navLinks = [
  { label: "ABOUT", href: "#about" },
  { label: "CATALOG", href: "#catalog" },
  { label: "SHIPPING", href: "#shipping" },
  { label: "CONTACTS", href: "#contacts" },
];
---
<aside
  class="motion-nav-shell hidden md:flex fixed left-0 top-0 h-screen w-[260px] flex-col justify-between border-r border-border bg-white px-6 py-8"
  data-nav-shell
>
  <div class="space-y-10">
    <a
      href="#top"
      class="motion-nav-link text-xl font-semibold tracking-wide focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2"
      data-nav
    >
      LOGO
    </a>
    <nav
      class="motion-nav space-y-4 text-sm font-semibold tracking-[0.2em] text-muted"
      data-nav-group
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="motion-nav-link block transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2"
          data-nav
        >
          {link.label}
        </a>
      ))}
      <span class="motion-nav-indicator" data-nav-indicator aria-hidden="true"></span>
    </nav>
  </div>
  <div></div>
</aside>
