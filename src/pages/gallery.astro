---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import ProductGrid from "../components/ProductGrid.astro";
import FooterSocial from "../components/FooterSocial.astro";
import ProductModal from "../components/ProductModal.astro";
import { products } from "../data/products";
---
<BaseLayout title="Pod Lopuhom | Gallery">
  <Nav />
  <main class="mx-auto w-full max-w-6xl space-y-16 px-6 pb-28 pt-12">
    <section class="space-y-6 text-center">
      <h1 class="text-3xl font-semibold text-slate-900 md:text-5xl">
        Gallery
      </h1>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {["Rings", "Pendants", "Earrings", "Sets"].map((label) => (
          <button
            type="button"
            class="rounded-full border border-slate-200 bg-white px-5 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700 transition hover:border-slate-300 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
          >
            {label}
          </button>
        ))}
      </div>
    </section>

    <section id="gallery" class="space-y-12">
      <ProductGrid products={products} enableModal />
    </section>
  </main>
  <FooterSocial />

  <ProductModal />

  <script>
    const backdrop = document.querySelector("[data-modal-backdrop]");
    const modal = document.querySelector("[data-modal]");
    const title = document.querySelector("[data-modal-title]");
    const description = document.querySelector("[data-modal-description]");
    const price = document.querySelector("[data-modal-price]");
    const priceSticky = document.querySelector("[data-modal-price-sticky]");
    const mainImage = document.querySelector("[data-modal-main]");
    const thumbs = document.querySelector("[data-modal-thumbs]");
    const cta = document.querySelector("[data-modal-cta]");
    const ctaSticky = document.querySelector("[data-modal-cta-sticky]");
    const panel = document.querySelector("[data-modal-panel]");
    const closeBtn = document.querySelector("[data-modal-close]");

    const whatsappNumber = "972533794428";
    const activeThumbClass =
      "border-slate-900 ring-2 ring-inset ring-slate-900";
    const imageFocus = {
      "/images/products/product_7.0.JPG": "35% 55%",
    };
    const getObjectPosition = (src) => imageFocus[src] || "50% 50%";

    let galleryImages = [];
    let activeIndex = 0;
    let thumbButtons = [];

    const setActiveThumb = (index) => {
      thumbButtons.forEach((thumb, thumbIndex) => {
        const isActive = thumbIndex === index;
        thumb.classList.toggle("border-slate-200", !isActive);
        thumb.classList.toggle("border-slate-900", isActive);
        thumb.classList.toggle("ring-2", isActive);
        thumb.classList.toggle("ring-inset", isActive);
        thumb.classList.toggle("ring-slate-900", isActive);
        thumb.setAttribute("aria-current", isActive ? "true" : "false");
      });
    };

    const setActiveImage = (index) => {
      if (!mainImage || galleryImages.length === 0) return;
      const nextIndex = (index + galleryImages.length) % galleryImages.length;
      activeIndex = nextIndex;
      mainImage.src = galleryImages[nextIndex];
      mainImage.alt = title?.textContent || "";
      mainImage.style.objectPosition = getObjectPosition(galleryImages[nextIndex]);
      setActiveThumb(nextIndex);
    };

    const openModal = (originX, originY) => {
      if (!backdrop || !modal) return;
      backdrop.classList.remove("pointer-events-none", "opacity-0");
      backdrop.classList.add("opacity-100");
      modal.classList.remove("pointer-events-none");
      modal.classList.add("pointer-events-auto");
      modal.style.transformOrigin = `${originX}px ${originY}px`;
      modal.classList.remove("opacity-0", "translate-y-3", "scale-95");
      modal.classList.add("opacity-100", "translate-y-0", "scale-100");
      modal.setAttribute("aria-hidden", "false");
      backdrop.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      if (!backdrop || !modal) return;
      backdrop.classList.add("pointer-events-none", "opacity-0");
      backdrop.classList.remove("opacity-100");
      modal.classList.add("pointer-events-none");
      modal.classList.remove("pointer-events-auto");
      modal.classList.add("opacity-0", "translate-y-3", "scale-95");
      modal.classList.remove("opacity-100", "translate-y-0", "scale-100");
      modal.setAttribute("aria-hidden", "true");
      backdrop.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    document.querySelectorAll("[data-product]").forEach((button) => {
      button.addEventListener("click", (event) => {
        galleryImages = JSON.parse(button.getAttribute("data-images") || "[]");
        activeIndex = 0;
        const productTitle = button.getAttribute("data-title") || "";
        const productDescription = button.getAttribute("data-description") || "";
        const productPrice = button.getAttribute("data-price") || "";
        const message = encodeURIComponent(
          `Hi! I want to order: ${productTitle} (${productPrice}).`
        );

        if (title) title.textContent = productTitle;
        if (description) description.textContent = productDescription;
        if (price) price.textContent = productPrice;
        if (priceSticky) priceSticky.textContent = productPrice;
        if (cta) cta.href = `https://wa.me/${whatsappNumber}?text=${message}`;
        if (ctaSticky) {
          ctaSticky.href = `https://wa.me/${whatsappNumber}?text=${message}`;
        }

        if (thumbs) {
          thumbs.innerHTML = "";
          thumbButtons = [];
          galleryImages.slice(0, 4).forEach((image, index) => {
            const thumb = document.createElement("button");
            thumb.type = "button";
            thumb.className =
              "group aspect-square h-16 w-16 overflow-hidden rounded-2xl border border-slate-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 sm:h-20 sm:w-20";
            thumb.setAttribute("aria-label", `View image ${index + 1}`);
            thumb.setAttribute("aria-current", index === 0 ? "true" : "false");
            if (index === 0) {
              thumb.classList.add(...activeThumbClass.split(" "));
            } else {
              thumb.classList.add("border-slate-200");
            }
            thumb.innerHTML = `<img src="${image}" alt="${productTitle} thumbnail ${index + 1}" class="h-full w-full object-cover object-center transition duration-200 group-hover:scale-[1.03]" loading="eager" fetchpriority="high" />`;
            const swapImage = () => setActiveImage(index);
            thumb.addEventListener("mouseenter", swapImage);
            thumb.addEventListener("focus", swapImage);
            thumb.addEventListener("click", swapImage);
            thumbs.appendChild(thumb);
            thumbButtons.push(thumb);
          });
        }

        setActiveImage(0);
        const rect = modal.getBoundingClientRect();
        const originX = event.clientX - rect.left;
        const originY = event.clientY - rect.top;
        openModal(originX, originY);
      });
    });

    if (mainImage) {
      let touchStartX = 0;
      const swipeThreshold = 40;
      // Subtle swipe handler for gallery navigation.
      mainImage.addEventListener("touchstart", (event) => {
        touchStartX = event.touches[0].clientX;
      });
      mainImage.addEventListener("touchend", (event) => {
        const touchEndX = event.changedTouches[0].clientX;
        const deltaX = touchEndX - touchStartX;
        if (Math.abs(deltaX) < swipeThreshold) return;
        setActiveImage(deltaX < 0 ? activeIndex + 1 : activeIndex - 1);
      });
    }

    closeBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (event) => {
      if (panel && !panel.contains(event.target)) {
        closeModal();
      }
    });
    backdrop?.addEventListener("click", (event) => {
      if (event.target === backdrop) closeModal();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeModal();
    });
  </script>
</BaseLayout>
