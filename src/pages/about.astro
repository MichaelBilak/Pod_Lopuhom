---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import FooterSocial from "../components/FooterSocial.astro";
---
<BaseLayout title="MAMA | About">
  <Nav />
  <main class="mx-auto w-full max-w-5xl space-y-16 px-6 pb-28 pt-12">
    <section class="mx-auto max-w-3xl space-y-6 text-center">
      <h1 class="text-3xl font-semibold text-slate-900 md:text-4xl">About</h1>
      <p class="text-base text-slate-600">
        Each piece is created by hand with attention to materials, texture, and
        light. We keep our collections small, so every order feels personal and
        intentional.
      </p>
    </section>
  </main>
  <FooterSocial />
</BaseLayout>
