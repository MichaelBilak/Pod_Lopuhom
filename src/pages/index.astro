---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import ProductGrid from "../components/ProductGrid.astro";
import FooterSocial from "../components/FooterSocial.astro";
import { products } from "../data/products";
---
<BaseLayout title="MAMA | Gallery">
  <Nav />
  <main class="mx-auto w-full max-w-5xl space-y-24 px-6 pb-28 pt-16">
    <section class="space-y-8 text-center">
      <div class="mx-auto flex h-32 w-32 items-center justify-center rounded-full border border-slate-300 text-sm uppercase tracking-[0.35em] text-slate-500">
        Logo
      </div>
      <div class="space-y-4">
        <h1 class="text-3xl font-semibold text-slate-900 md:text-5xl">
          Handmade jewelry, softly crafted in Haifa.
        </h1>
        <p class="mx-auto max-w-xl text-base text-slate-600">
          A calm collection of small-batch pieces. Choose a piece, message us,
          and we will prepare it with care.
        </p>
      </div>
    </section>

    <section id="gallery" class="space-y-12">
      <ProductGrid products={products} enableModal />
    </section>

    <section id="about" class="mx-auto max-w-3xl space-y-6 text-center">
      <h2 class="text-2xl font-semibold text-slate-900">About</h2>
      <p class="text-base text-slate-600">
        Each piece is created by hand with attention to materials, texture, and
        light. We keep our collections small, so every order feels personal and
        intentional.
      </p>
    </section>
  </main>
  <FooterSocial />

  <div
    class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center bg-black/35 opacity-0 transition-opacity duration-300 ease-out"
    data-modal-backdrop
    aria-hidden="true"
  >
    <div
      class="pointer-events-none mx-4 w-full max-w-4xl translate-y-3 scale-95 opacity-0 transition-[transform,opacity] duration-300 ease-out will-change-transform sm:mx-6"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      data-modal
    >
      <div
        class="rounded-3xl border border-white/70 bg-white/95 p-4 shadow-[0_30px_80px_rgba(15,23,42,0.25)] sm:max-h-[85vh] sm:overflow-y-auto sm:p-6"
        data-modal-panel
      >
        <div class="flex items-start justify-between">
          <h2 class="text-2xl font-semibold text-slate-900" data-modal-title></h2>
          <button
            type="button"
            class="text-2xl text-slate-500 transition hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
            data-modal-close
            aria-label="Close"
          >
            ×
          </button>
        </div>
        <div class="mt-6 grid gap-8 lg:grid-cols-[1.1fr,0.9fr]">
          <div class="grid gap-0 md:grid-cols-[72px,1fr]">
            <div class="order-2 flex gap-3 overflow-x-auto md:order-1 md:flex-col md:overflow-visible" data-modal-thumbs></div>
            <div class="order-1 overflow-hidden rounded-3xl bg-slate-100">
              <img
                src=""
                alt=""
                class="h-full w-full object-cover"
                data-modal-main
              />
            </div>
          </div>
          <div class="space-y-4">
            <p class="text-sm text-slate-600" data-modal-description></p>
            <p class="text-2xl font-semibold text-slate-900" data-modal-price></p>
            <a
              href="#"
              target="_blank"
              rel="noreferrer"
              class="inline-flex w-fit items-center justify-center rounded-full border border-slate-900 px-6 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-slate-900 transition hover:bg-slate-900 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
              data-modal-cta
            >
              Choose and message
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const backdrop = document.querySelector("[data-modal-backdrop]");
    const modal = document.querySelector("[data-modal]");
    const title = document.querySelector("[data-modal-title]");
    const description = document.querySelector("[data-modal-description]");
    const price = document.querySelector("[data-modal-price]");
    const mainImage = document.querySelector("[data-modal-main]");
    const thumbs = document.querySelector("[data-modal-thumbs]");
    const cta = document.querySelector("[data-modal-cta]");
    const panel = document.querySelector("[data-modal-panel]");
    const closeBtn = document.querySelector("[data-modal-close]");

    const whatsappNumber = "972501234567";

    const openModal = (originX, originY) => {
      if (!backdrop || !modal) return;
      backdrop.classList.remove("pointer-events-none", "opacity-0");
      backdrop.classList.add("opacity-100");
      modal.classList.remove("pointer-events-none");
      modal.classList.add("pointer-events-auto");
      modal.style.transformOrigin = `${originX}px ${originY}px`;
      modal.classList.remove("opacity-0", "translate-y-3", "scale-95");
      modal.classList.add("opacity-100", "translate-y-0", "scale-100");
      modal.setAttribute("aria-hidden", "false");
      backdrop.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      if (!backdrop || !modal) return;
      backdrop.classList.add("pointer-events-none", "opacity-0");
      backdrop.classList.remove("opacity-100");
      modal.classList.add("pointer-events-none");
      modal.classList.remove("pointer-events-auto");
      modal.classList.add("opacity-0", "translate-y-3", "scale-95");
      modal.classList.remove("opacity-100", "translate-y-0", "scale-100");
      modal.setAttribute("aria-hidden", "true");
      backdrop.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    document.querySelectorAll("[data-product]").forEach((button) => {
      button.addEventListener("click", (event) => {
        const images = JSON.parse(button.getAttribute("data-images") || "[]");
        const productTitle = button.getAttribute("data-title") || "";
        const productDescription = button.getAttribute("data-description") || "";
        const productPrice = button.getAttribute("data-price") || "";
        const message = encodeURIComponent(
          `Hi! I want to order: ${productTitle} (${productPrice}).`
        );

        if (title) title.textContent = productTitle;
        if (description) description.textContent = productDescription;
        if (price) price.textContent = productPrice;
        if (mainImage) {
          mainImage.src = images[0] || "";
          mainImage.alt = productTitle;
        }
        if (cta) {
          cta.href = `https://wa.me/${whatsappNumber}?text=${message}`;
        }

        if (thumbs) {
          thumbs.innerHTML = "";
          images.slice(0, 4).forEach((image, index) => {
            const thumb = document.createElement("button");
            thumb.type = "button";
            thumb.className =
              "group h-16 w-16 overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2";
            thumb.setAttribute("aria-label", `View image ${index + 1}`);
            thumb.innerHTML = `<img src="${image}" alt="${productTitle} thumbnail ${index + 1}" class="h-full w-full object-cover transition duration-200 group-hover:scale-[1.03]" loading="lazy" />`;
            thumb.addEventListener("click", () => {
              if (mainImage) {
                mainImage.src = image;
                mainImage.alt = productTitle;
              }
            });
            thumbs.appendChild(thumb);
          });
        }

        const rect = modal.getBoundingClientRect();
        const originX = event.clientX - rect.left;
        const originY = event.clientY - rect.top;
        openModal(originX, originY);
      });
    });

    closeBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (event) => {
      if (panel && !panel.contains(event.target)) {
        closeModal();
      }
    });
    backdrop?.addEventListener("click", (event) => {
      if (event.target === backdrop) closeModal();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeModal();
    });
  </script>
</BaseLayout>
