---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import FooterSocial from "../components/FooterSocial.astro";
import { getLocaleFromUrl, getTranslations } from "../lib/i18n";

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
---
<BaseLayout title="Pod Lopuhom | Gallery" locale={locale}>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href="/images/hero%20img/07f7770a-2ca1-441e-916d-74066ce348be.jpg"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero%20img/IMG_2028.JPG"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero%20img/IMG_3292.JPG"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero%20img/IMG_6353%20(2).JPG"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero%20img/IMG_6912.jpg"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero%20img/IMG_9258.JPG"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/products/Logo.%20pod_lopuhom.jpeg"
      fetchpriority="high"
    />
  </Fragment>
  <Nav />
  <main class="mx-auto w-full max-w-6xl space-y-20 px-6 pb-28 pt-12">
    <section class="hero-panel text-center">
      <div class="hero-backdrop" aria-hidden="true">
        <img
          class="hero-slide"
          src="/images/hero%20img/07f7770a-2ca1-441e-916d-74066ce348be.jpg"
          alt=""
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
        <img
          class="hero-slide"
          src="/images/hero%20img/IMG_2028.JPG"
          alt=""
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
        <img
          class="hero-slide"
          src="/images/hero%20img/IMG_3292.JPG"
          alt=""
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
        <img
          class="hero-slide"
          src="/images/hero%20img/IMG_6353%20(2).JPG"
          alt=""
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
        <img
          class="hero-slide"
          src="/images/hero%20img/IMG_6912.jpg"
          alt=""
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
        <img
          class="hero-slide"
          src="/images/hero%20img/IMG_9258.JPG"
          alt=""
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero-wash"></span>
      </div>
      <div class="relative z-10 space-y-6">
        <div class="mx-auto flex h-24 w-24 items-center justify-center overflow-hidden rounded-full bg-white shadow-[0_6px_18px_rgba(15,23,42,0.06)] sm:h-28 sm:w-28">
          <img
            src="/images/products/Logo.%20pod_lopuhom.jpeg"
            alt="Pod Lopuhom logo"
            class="h-full w-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="space-y-6">
          <h1 class="text-3xl font-semibold text-slate-900 md:text-5xl">
            {t.home.title}
          </h1>
          <p class="mx-auto max-w-xl text-base text-slate-700">
            {t.home.subtitle}
          </p>
        </div>
      </div>
    </section>
    <div class="flex flex-wrap items-center justify-center gap-4 text-center">
      {[t.categories.rings, t.categories.necklaces, t.categories.earrings, t.categories.sets].map((label) => (
        <button
          type="button"
          class="bg-transparent px-2 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-slate-700 underline decoration-slate-300 decoration-2 underline-offset-[10px] transition hover:text-slate-900 hover:decoration-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
        >
          {label}
        </button>
      ))}
    </div>
  </main>
  <FooterSocial />
</BaseLayout>
